			{
				builder.WithMaxAmount(1);
			});
			List<(NamespacedKey<DawnMoonInfo>, string)> list = new List<(NamespacedKey<DawnMoonInfo>, string)>(4)
			{
				(null, "any moon"),
				(MoonKeys.Embrion, "Embrion"),
				(MoonKeys.Artifice, "Artifice"),
				(MoonKeys.Titan, "Titan")
			};
			foreach (var item in list)
			{
				var (moonKey, moonName) = item;
